{% extends "../partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = applicationName + " - Error" %}
{% set mainClasses = "govuk-body" %}

{% block content %}

  <h1>{{ message | safe }}</h1>
  <h2>{{ status }}</h2>
  <pre>{{ stack }}</pre>

  {% if accessDenied %}
    {{ govukButton({
        text: "Return Home",
        href: launchpadHome,
        type: "submit"
     }) }}
   {% endif %}

{% endblock %}
