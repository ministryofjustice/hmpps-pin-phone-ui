{% extends "../../partials/layout.njk" %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{%- from "moj/components/pagination/macro.njk" import mojPagination -%}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% set backLinkHref = "/pin-phone" %}
{% set pageTitle = "View PIN phone contacts" %}

{% block pageTitle %}
  {{ pageTitle }} - GOV.UK
{% endblock %}

{% block content %}
  <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

  {% if hasContacts %}
    {{ govukInsetText({
        html: 'If you want to add, change or delete a number, go to Apps and select <a class="govuk-link" href="' + pinPhoneApps + '">PIN phones apps</a>.'
    }) }}

    {{ govukTable({
      classes: "govuk-!-width-three-quarters",
      head: [
        { text: "Name", classes: "govuk-!-width-one-third" },
        { text: "Phone number", classes: "govuk-!-width-one-third" },
        { text: "Contact type", classes: "govuk-!-width-one-third" },
        { text: "Relationship", classes: "govuk-!-width-one-third" }
      ],
      rows: tableRows
    }) }}
    {{ mojPagination(pagination) }}
  {% else %}
    <p class="govuk-body govuk-!-font-weight-bold">You have no approved contacts at the moment.</p>
    {{ govukInsetText({
        html: 'To add or remove contacts go to Apps and choose <a class="govuk-link govuk-link--no-underline" href="' + pinPhoneApps + '">PIN phones apps</a>'
    }) }}
  {% endif %}
{% endblock %}
